# Base URL of the merchant backend, including the /api/v1 version segment.
# The backend uses NestJS URI versioning with no global prefix, so versioned
# routes live at /api/v1/... while liveness sits unversioned at /health.
#
# The backend listens on port 3000 in local dev, so run this app's dev server
# on another port:  pnpm dev -- -p 3001
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3000/api/v1
